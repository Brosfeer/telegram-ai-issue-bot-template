# ==============================================================================
# Telegram AI Issue Bot - Environment Configuration Template
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Primary Super Admin Telegram User ID (numeric, from @userinfobot)
ADMIN_USER_ID=0

# Initial comma-separated whitelist of authorized Telegram User IDs (e.g. 111111111,222222222)
ALLOWED_USER_IDS=

# Target GitHub Repository identifier (format: owner/repo)
TARGET_REPO_NAME=owner/repository

# Absolute path to the target repository directory on disk
TARGET_REPO_DIR=/path/to/target/repository

# Default working / base branch in target repository
TARGET_BASE_BRANCH=main

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Storage path for QA screenshots (relative to project root or absolute)
STORAGE_DIR=data/images

# SQLite database file path (relative to project root or absolute)
DB_PATH=data/bot.db

# Path to Antigravity CLI executable (optional, for autonomous AI synthesis)
AGY_PATH=/usr/local/bin/agy
